# Copy this file to .env.local and fill it in from YOUR Supabase project (Project Settings > API).
# .env.local stays on your computer: it is never committed and never uploaded.

# Your project's URL, like https://<your-project-ref>.<the address Supabase shows you>
NEXT_PUBLIC_SUPABASE_URL=
# The "anon" or "publishable" key. Safe in the browser: row-level security protects the data.
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Where the game lives. Locally: http://localhost:3000. Live: your Vercel address.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# LOCAL ONLY, for scripts/create-invite.mjs (minting your own first invite).
# The secret key. Never put it in Vercel, never prefix it with NEXT_PUBLIC_, never share it.
SUPABASE_SERVICE_ROLE_KEY=

# Optional, for the database tests: a throwaway Postgres whose database name ends in _test.
TEST_DATABASE_URL=
